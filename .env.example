# --- Contact form (required for /api/contact) ---
# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend (Resend -> Domains). Does not need a
# real mailbox on that domain - Resend only needs the DNS records.
CONTACT_FROM="Portfolio <contact@yourdomain.com>"
# Where messages actually land - any inbox, e.g. your Gmail address.
CONTACT_TO=you@gmail.com

# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x xxxxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x xxxxxxxxxxxxxxxxxxxxxx

# --- GitHub activity (optional, /api/github) ---
# Create at https://github.com/settings/tokens (no scopes needed for public data)
# Note: README mentions NEXT_PUBLIC_GITHUB_TOKEN, but code reads GITHUB_TOKEN.
GITHUB_TOKEN=
GITHUB_USERNAME=AbhishekSinghDev
